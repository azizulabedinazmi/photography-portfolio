# Copy to .env (git-ignored) for local use; on Netlify add the same names under
# Site configuration -> Environment variables. Never commit real values.

# Cloudflare dashboard -> R2 -> Overview (right side): Account ID
R2_ACCOUNT_ID=
# R2 -> Manage API tokens -> Create API token (Object Read & Write, this bucket only)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket that holds the full-size photo originals
R2_BUCKET=
# Folder inside the bucket (default: photography/)
R2_PREFIX=photography/
