# Netlify Blobs is the storage layer. Netlify supplies these automatically
# when the site is deployed. Do not commit your real .env file.

# Admin credentials. Use a long random password in production.
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=change-this-password

# Used to sign the HttpOnly admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

