---
// Dedicated EXIF & Behind-the-Scenes Story Popover Modal
---

<div id="exif-modal-backdrop" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<div id="exif-modal" class="fixed bottom-0 sm:bottom-auto sm:top-1/2 sm:left-1/2 sm:-translate-x-1/2 sm:-translate-y-1/2 w-full sm:max-w-xl max-h-[85dvh] bg-white dark:bg-neutral-950 rounded-t-3xl sm:rounded-3xl z-50 shadow-2xl border border-neutral-200 dark:border-neutral-800 p-6 sm:p-8 transform translate-y-full sm:translate-y-8 opacity-0 pointer-events-none transition-all duration-300 flex flex-col overflow-hidden">
  
  <!-- Header -->
  <div class="flex items-start justify-between gap-4 pb-4 border-b border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
      </div>
      <div>
        <h3 id="exif-title" class="font-serif font-bold text-lg sm:text-xl text-neutral-900 dark:text-white leading-tight">Photo Title</h3>
        <p id="exif-category" class="text-xs font-mono text-neutral-500 uppercase tracking-wider mt-0.5">Portrait · Fine Art</p>
      </div>
    </div>

    <button id="exif-close-btn" class="p-2 rounded-full hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-400 hover:text-black dark:hover:text-white transition" aria-label="Close EXIF details">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Scrollable Details -->
  <div class="flex-1 overflow-y-auto py-5 space-y-6">
    
    <!-- Details: real camera EXIF for photos, edit details for digital art (filled by portfolio-smart.js) -->
    <div>
      <div id="exif-params-title" class="text-[11px] font-mono uppercase tracking-widest text-neutral-400 mb-3 flex items-center gap-1.5"></div>
      <div id="exif-params" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
      <p id="exif-params-note" class="hidden text-[11px] text-neutral-400 mt-2"></p>
    </div>

    <!-- Gear / Tools -->
    <div id="exif-gear" class="p-4 rounded-xl bg-neutral-50 dark:bg-neutral-900 border border-neutral-200/70 dark:border-neutral-800 space-y-2"></div>

    <!-- Story Behind the Shot -->
    <div>
      <div class="text-[11px] font-mono uppercase tracking-widest text-neutral-400 mb-2 flex items-center gap-1.5">
        <span>📖</span> Behind the Lens & Story
      </div>
      <p id="exif-story" class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 font-light leading-relaxed bg-neutral-50 dark:bg-neutral-900/50 p-4 rounded-xl border border-neutral-200/60 dark:border-neutral-800">
        Captured during golden hour natural light, balancing soft shadow gradients with authentic candid gaze.
      </p>
    </div>

    <!-- Tags -->
    <div>
      <div class="text-[11px] font-mono uppercase tracking-widest text-neutral-400 mb-2">Tags & Keywords</div>
      <div id="exif-tags" class="flex flex-wrap gap-1.5"></div>
    </div>

  </div>

  <!-- Footer Actions -->
  <div class="pt-4 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between gap-4">
    <button type="button" onclick="document.getElementById('exif-close-btn').click();" class="px-5 py-2.5 rounded-full text-xs font-semibold text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition">
      Close Window
    </button>
    <a id="exif-zoom-btn" href="#" data-fancybox="gallery" class="px-5 py-2.5 rounded-full bg-black dark:bg-white text-white dark:text-black text-xs font-semibold hover:opacity-90 transition shadow-sm">
      Open Fullscreen View ↗
    </a>
  </div>

</div>
