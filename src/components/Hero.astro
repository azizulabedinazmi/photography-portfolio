---
// Hero component with dynamic rotating headline and cinematic filmstrip marquee
import galleryData from '../../dist/gallery-data.json';

const heroItems: any[] = Array.isArray(galleryData) ? galleryData : (galleryData as any).items || [];
const total = heroItems.length;
const artCount = heroItems.filter((i) => i.category === 'art').length;
const seriesCount = heroItems.filter((i) => i.isSeries).length;
---

<section class="relative pt-12 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
  
  <!-- Ambient Animated Aurora Glow Orbs in Background -->
  <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-gradient-to-tr from-amber-500/15 via-rose-500/15 to-purple-500/15 filter blur-3xl pointer-events-none animate-aurora-1"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 rounded-full bg-gradient-to-bl from-blue-500/15 via-indigo-500/15 to-pink-500/15 filter blur-3xl pointer-events-none animate-aurora-2"></div>

  <div class="max-w-4xl relative z-10">
    
    <!-- Animated Status Badge -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full text-xs font-mono font-medium tracking-wider uppercase bg-neutral-100/80 dark:bg-neutral-900/80 backdrop-blur-md text-neutral-800 dark:text-neutral-200 border border-neutral-200/80 dark:border-neutral-800 mb-6 shadow-sm">
      <span class="flex h-2 w-2 relative">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
      </span>
      Photography & Digital Artworks
    </div>

    <!-- Animated Rotating Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.08] mb-6">
      Capturing <br class="sm:hidden" />
      <span id="rotating-headline-word" class="inline-block text-amber-500 dark:text-amber-400 underline decoration-amber-400/40 underline-offset-8 transition-all duration-300">
        Soul & Light
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl font-light mb-8">
      Personal portfolio of <strong class="text-neutral-900 dark:text-white font-medium">Azizul Abedin Azmi</strong> — exploring human vulnerability, cultural street stories, and imaginative digital photo edits.
    </p>

    <!-- Action Buttons -->
    <div class="flex flex-wrap items-center gap-4">
      <a href="#gallery-section" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-black dark:bg-white text-white dark:text-black font-semibold text-sm hover:opacity-90 transition shadow-xl hover:scale-105 active:scale-95">
        <span>Explore Works ↓</span>
        <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg>
      </a>

      <button type="button" class="open-zen-btn inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-neutral-100 dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-800 font-medium text-sm hover:bg-neutral-200 dark:hover:bg-neutral-800 transition hover:scale-105 active:scale-95 shadow-sm">
        <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/></svg>
        <span>✨ Zen Exhibition Mode (Z)</span>
      </button>


      <a href="/contact" class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white font-medium text-sm transition">
        <span>Say Hello →</span>
      </a>
    </div>

    <!-- Quick Metrics Strip -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-10 mt-10 border-t border-neutral-200/80 dark:border-neutral-800/80">
      <div>
        <div class="text-2xl sm:text-3xl font-bold font-serif text-neutral-900 dark:text-white">{total}+</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono uppercase tracking-wider mt-0.5">Master Works</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold font-serif text-neutral-900 dark:text-white">{artCount}</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono uppercase tracking-wider mt-0.5">Digital Artworks</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold font-serif text-neutral-900 dark:text-white">{seriesCount} Series</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono uppercase tracking-wider mt-0.5">Curated Stories</div>
      </div>
      <div>
        <div class="text-2xl sm:text-3xl font-bold font-serif text-neutral-900 dark:text-white">Camera & Canvas</div>
        <div class="text-xs text-neutral-500 dark:text-neutral-400 font-mono uppercase tracking-wider mt-0.5">Dual Mediums</div>
      </div>
    </div>
  </div>

  <!-- Cinematic Continuous Rolling Filmstrip Marquee -->
  <div class="mt-14 pt-8 border-t border-neutral-200/70 dark:border-neutral-800/80">
    <div class="flex items-center justify-between mb-4">
      <span class="text-xs font-mono uppercase tracking-widest text-neutral-400 dark:text-neutral-500 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
        Featured Highlights Filmstrip (Hover to Pause)
      </span>
    </div>
    <div class="overflow-hidden relative select-none">
      <div id="filmstrip-marquee-inner" class="animate-marquee flex gap-4">
        <!-- Injected dynamically by client JS -->
      </div>
    </div>
  </div>

</section>
