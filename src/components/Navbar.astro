---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '/index.html';
const isAbout = pathname === '/about' || pathname === '/about/' || pathname.includes('about_me');
const isContact = pathname === '/contact' || pathname === '/contact/';
---

<header class="sticky top-0 z-40 w-full glass-header border-b border-neutral-200/70 dark:border-neutral-800/80 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    
    <!-- Brand Logo / Name -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-neutral-950 border border-neutral-800 flex items-center justify-center p-1 shadow-md group-hover:scale-105 group-hover:border-amber-400/60 transition-all duration-300 overflow-hidden">
          <img src="/dist/assets/favicon-32x32.png" alt="Azmi Brand Icon" class="w-full h-full object-contain rounded-lg">
        </div>
        <div>
          <!-- Transparent wordmark: black logo on the light theme, white logo on the dark theme -->
          <div class="h-6 sm:h-7 group-hover:opacity-80 transition">
            <span class="sr-only">〘卂乙爪丨〙ヅ Azmi</span>
            <img src="/dist/assets/logo-on-light.webp" alt="" aria-hidden="true" width="453" height="96" class="h-full w-auto block dark:hidden" />
            <img src="/dist/assets/logo-on-dark.webp" alt="" aria-hidden="true" width="453" height="96" class="h-full w-auto hidden dark:block" />
          </div>
          <div class="flex items-center gap-2 mt-1">
            <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <!-- Two taglines that take turns (stacked in one grid cell so the width never jumps) -->
            <span class="nav-tagline grid text-[11px] font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 whitespace-nowrap">
              <span class="nav-tagline-a">Shooting for fun</span>
              <span class="nav-tagline-b" aria-hidden="true">Lens by day · Dev by night</span>
            </span>
          </div>
          <style is:inline>
            .nav-tagline > span { grid-area: 1 / 1; }
            .nav-tagline-a { animation: nav-tag-a 8s ease-in-out infinite; }
            .nav-tagline-b { opacity: 0; animation: nav-tag-b 8s ease-in-out infinite; }
            @keyframes nav-tag-a { 0%, 42% { opacity: 1; } 50%, 92% { opacity: 0; } 100% { opacity: 1; } }
            @keyframes nav-tag-b { 0%, 42% { opacity: 0; } 50%, 92% { opacity: 1; } 100% { opacity: 0; } }
            @media (prefers-reduced-motion: reduce) {
              .nav-tagline-a, .nav-tagline-b { animation: none; }
              .nav-tagline-b { display: none; }
            }
          </style>
        </div>
      </a>
    </div>

    <!-- Center Nav Links (Desktop) -->
    <nav class="hidden md:flex items-center space-x-5 lg:space-x-8 whitespace-nowrap font-medium text-sm tracking-wide">
      <a href="/" class={`relative py-1 transition group ${isHome ? 'text-black dark:text-white font-semibold' : 'text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white'}`}>
        PORTFOLIO & ART
        <span class={`absolute inset-x-0 bottom-0 h-0.5 bg-black dark:bg-white rounded-full transition-transform origin-left ${isHome ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`}></span>
      </a>
      <a href="/about" class={`relative py-1 transition group ${isAbout ? 'text-black dark:text-white font-semibold' : 'text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white'}`}>
        ABOUT ME
        <span class={`absolute inset-x-0 bottom-0 h-0.5 bg-black dark:bg-white rounded-full transition-transform origin-left ${isAbout ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`}></span>
      </a>
      <a href="/contact" class={`relative py-1 transition group ${isContact ? 'text-black dark:text-white font-semibold' : 'text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white'}`}>
        CONTACT
        <span class={`absolute inset-x-0 bottom-0 h-0.5 bg-black dark:bg-white rounded-full transition-transform origin-left ${isContact ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`}></span>
      </a>
      <a href="http://azizulabedinazmi.is-a.dev/" target="_blank" rel="noopener noreferrer" class="relative py-1 text-neutral-600 dark:text-neutral-400 hover:text-amber-500 dark:hover:text-amber-400 transition group inline-flex items-center gap-1 font-mono text-xs uppercase" title="Visit Developer Portfolio">
        <span>&lt;/&gt; DEV PORTFOLIO</span>
        <svg class="w-3.5 h-3.5 opacity-70 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
      </a>
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2 sm:gap-3">
      
      <!-- Sound FX Toggle Button -->
      <button type="button" class="sound-toggle-btn p-2.5 rounded-full text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition active:scale-95" title="Toggle Shutter Sounds & Camera Flash (S)">
        <svg class="sound-icon-on w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.414 0-.75-.336-.75-.75V9c0-.414.336-.75.75-.75h2.24z"/></svg>
        <svg class="sound-icon-off w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 9.75L19.5 12m0 0l2.25 2.25M19.5 12l2.25-2.25M19.5 12l-2.25 2.25m-10.5-3l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.414 0-.75-.336-.75-.75V9c0-.414.336-.75.75-.75h2.24z"/></svg>
      </button>

      <!-- Dark / Light Theme Toggle -->
      <button type="button" class="theme-toggle-btn p-2.5 rounded-full text-neutral-600 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition active:rotate-45" title="Toggle Theme (T)">
        <svg class="theme-icon-sun w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
        <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
      </button>

      <!-- Say Hello Quick Action -->
      <a href="/contact" class="hidden sm:inline-flex whitespace-nowrap shrink-0 items-center gap-1.5 px-4 py-2 rounded-full bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-xs font-semibold hover:opacity-90 transition shadow-sm active:scale-95">
        <span>Say Hello</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <div class="md:hidden">
        <button id="mobile-menu-toggle" type="button" class="p-2 rounded-lg text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800" aria-label="Toggle navigation menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/></svg>
        </button>
      </div>

    </div>

  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu-drawer" class="hidden md:hidden bg-white/95 dark:bg-neutral-900/95 backdrop-blur-xl border-b border-neutral-200 dark:border-neutral-800 px-6 py-6 shadow-2xl flex flex-col space-y-4 text-lg font-serif">
    <a href="/" class={`transition ${isHome ? 'font-bold text-black dark:text-white' : 'text-neutral-600 dark:text-neutral-400'}`}>PORTFOLIO & ART</a>
    <a href="/about" class={`transition ${isAbout ? 'font-bold text-black dark:text-white' : 'text-neutral-600 dark:text-neutral-400'}`}>ABOUT ME</a>
    <a href="/contact" class={`transition ${isContact ? 'font-bold text-black dark:text-white' : 'text-neutral-600 dark:text-neutral-400'}`}>CONTACT</a>
    <a href="http://azizulabedinazmi.is-a.dev/" target="_blank" rel="noopener noreferrer" class="text-neutral-600 dark:text-neutral-400 font-sans text-sm flex items-center justify-between border-t border-neutral-200 dark:border-neutral-800 pt-3">
      <span>&lt;/&gt; DEV PORTFOLIO & CODE</span>
      <span class="text-xs font-mono text-amber-500">azizulabedinazmi.is-a.dev ↗</span>
    </a>
  </div>
</header>

<script is:inline>
  // Mobile drawer toggle
  (function () {
    const toggle = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    if (toggle && drawer) {
      toggle.addEventListener('click', function () {
        drawer.classList.toggle('hidden');
      });
    }
  })();
</script>
