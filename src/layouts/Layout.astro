---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Extra robots directives, e.g. "noimageindex". */
  robots?: string;
  /** Comma-separated keywords; defaults to the owner's portfolio keywords. */
  keywords?: string;
  /** Author meta; pass null to omit (photo pages are about their subject, not the photographer). */
  author?: string | null;
  ogType?: string;
  siteName?: string;
}

const SITE = 'https://azmi.is-cool.dev';
const {
  title = "〘卂乙爪丨〙ヅ - Photography & Digital Art Portfolio",
  description = "The personal photography and digital art portfolio of Azizul Abedin Azmi: portraits, street and event moments, nature, and creative digital edits.",
  // The owner's own picture: the only image tied to the owner's name.
  image = "/dist/assets/Avatar.png",
  robots = '',
  keywords = "Azizul Abedin Azmi, photography, portfolio, digital art, photo manipulation, portrait photography",
  author = "Azizul Abedin Azmi",
  ogType = 'website',
  siteName = "Azizul Abedin Azmi · Photography & Art"
} = Astro.props;
const imageUrl = /^https?:/i.test(image) ? image : SITE + (image.startsWith('/') ? image : '/' + image);
const path = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
// Netlify serves pages as /about/ (and 301s /about there), so canonicals end with a slash.
const canonical = SITE + (path.endsWith('/') ? path : path + '/');
const robotsContent = [/noindex/.test(robots) ? '' : 'index, follow', robots, 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'].filter(Boolean).join(', ');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Loading screen fast-lock -->
  <script is:inline>
    document.documentElement.classList.add('sl-lock');
  </script>

  <style is:inline>
    #site-loader { display: none; }
    .sl-lock { overflow: hidden; }
    .sl-lock #site-loader {
      position: fixed; inset: 0; z-index: 9999; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 34px;
      min-height: 100dvh;
      background: radial-gradient(ellipse at 50% 42%, #1a170b 0%, #0b0b0b 58%, #060606 100%);
      color: #8f8f8f; font: 500 11px/1 "JetBrains Mono", ui-monospace, monospace;
    }
    #site-loader .sl-stage { position: relative; width: min(74vw, 420px); padding: 26px 30px; }
    #site-loader .sl-logo {
      display: block; width: 100%; height: auto; opacity: 0;
      animation: sl-focus 1.8s cubic-bezier(.2, .7, .2, 1) .15s forwards;
    }
    #site-loader .sl-shine {
      position: absolute; inset: 26px 30px; pointer-events: none;
      -webkit-mask: url(/dist/assets/loader-logo.webp) center / 100% 100% no-repeat;
              mask: url(/dist/assets/loader-logo.webp) center / 100% 100% no-repeat;
      background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.95) 50%, transparent 65%) -150% 0 / 60% 100% no-repeat;
      animation: sl-shine 3.4s ease-in-out 1.6s infinite;
    }
    #site-loader .sl-corner { position: absolute; width: 22px; height: 22px; border: 2px solid #ffe800; opacity: 0; animation: sl-corner 1.5s cubic-bezier(.2, .7, .2, 1) forwards; }
    #site-loader .sl-tl { top: -10px; left: -10px; border-right: 0; border-bottom: 0; --x: -14px; --y: -14px; }
    #site-loader .sl-tr { top: -10px; right: -10px; border-left: 0; border-bottom: 0; --x: 14px; --y: -14px; }
    #site-loader .sl-bl { bottom: -10px; left: -10px; border-right: 0; border-top: 0; --x: -14px; --y: 14px; }
    #site-loader .sl-br { bottom: -10px; right: -10px; border-left: 0; border-top: 0; --x: 14px; --y: 14px; }
    #site-loader .sl-dot { position: absolute; top: 4px; right: 8px; width: 7px; height: 7px; border-radius: 50%; background: #ff3b30; opacity: 0; animation: sl-rec 1.2s steps(2, jump-none) 1s infinite; }
    #site-loader .sl-meter { display: flex; flex-direction: column; align-items: center; gap: 12px; opacity: 0; animation: sl-fade .9s ease .8s forwards; }
    #site-loader .sl-bar { width: 180px; height: 2px; background: rgba(255,255,255,.12); border-radius: 2px; overflow: hidden; }
    #site-loader .sl-bar i { display: block; height: 100%; background: #ffe800; transform: scaleX(.04); transform-origin: left; transition: transform .7s cubic-bezier(.4, 0, .2, 1); }
    #site-loader .sl-pct { letter-spacing: .32em; text-transform: uppercase; }
    #site-loader .sl-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
    #site-loader.sl-out { animation: sl-out 1.1s ease .25s forwards; pointer-events: none; }
    #site-loader.sl-out .sl-flash { animation: sl-flash .55s ease-out forwards; }
    @keyframes sl-focus { 0% { opacity: 0; filter: blur(14px); transform: scale(1.08); } 60% { opacity: 1; } 100% { opacity: 1; filter: blur(0); transform: scale(1); } }
    @keyframes sl-shine { 0% { background-position: -150% 0; } 60%, 100% { background-position: 250% 0; } }
    @keyframes sl-corner { from { opacity: 0; transform: translate(var(--x), var(--y)); } to { opacity: 1; transform: none; } }
    @keyframes sl-rec { 0% { opacity: 1; } 100% { opacity: .15; } }
    @keyframes sl-fade { to { opacity: 1; } }
    @keyframes sl-flash { 0% { opacity: 0; } 25% { opacity: .55; } 100% { opacity: 0; } }
    @keyframes sl-out { to { opacity: 0; transform: scale(1.03); visibility: hidden; } }
    @keyframes sl-fade-out { to { opacity: 0; visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) {
      #site-loader .sl-logo { animation: sl-fade .4s ease forwards; }
      #site-loader .sl-shine, #site-loader .sl-dot, #site-loader .sl-flash { display: none; }
      #site-loader .sl-corner { animation: sl-fade .4s ease forwards; transform: none; }
      #site-loader.sl-out { animation: sl-fade-out .4s ease forwards; }
    }
  </style>

  <!-- SEO Meta Tags -->
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  {author && <meta name="author" content={author} />}
  <meta name="robots" content={robotsContent} />
  <meta name="theme-color" content="#0a0a0a" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imageUrl} />
  <meta property="og:site_name" content={siteName} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageUrl} />
  <meta name="twitter:creator" content="@azmi" />

  <link rel="canonical" href={canonical} />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/dist/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/dist/assets/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/dist/assets/apple-touch-icon.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Signika:wght@400;700&family=Nothing+You+Could+Do&display=swap" rel="stylesheet" />

  <!-- Fancybox v5 -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LYGXJF62M9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LYGXJF62M9');
  </script>

  <!-- Theme initialization to prevent FOUC -->
  <script is:inline>
    (function () {
      // Dark is the default for everyone; light only when the visitor picked it with the toggle.
      let stored = null;
      try { stored = localStorage.getItem('azmi_theme'); } catch (e) {}
      document.documentElement.classList.toggle('dark', stored !== 'light');
    })();
  </script>
  <slot name="head" />
</head>

<body class="bg-white dark:bg-[#0a0a0a] text-neutral-900 dark:text-neutral-100 min-h-[100dvh] transition-colors duration-300 font-sans selection:bg-neutral-800 selection:text-white dark:selection:bg-white dark:selection:text-black overflow-x-hidden flex flex-col justify-between">

  <!-- Camera Shutter Flash Overlay -->
  <div id="camera-flash" class="fixed inset-0 bg-white pointer-events-none z-[9998] opacity-0"></div>

  <!-- Loading Screen -->
  <div id="site-loader" role="status" aria-live="polite" aria-label="Loading portfolio">
    <div class="sl-stage">
      <span class="sl-corner sl-tl"></span><span class="sl-corner sl-tr"></span>
      <span class="sl-corner sl-bl"></span><span class="sl-corner sl-br"></span>
      <span class="sl-dot"></span>
      <img class="sl-logo" src="/dist/assets/loader-logo.webp" width="720" height="153" alt="〘卂乙爪丨〙ヅ" />
      <span class="sl-shine"></span>
    </div>
    <div class="sl-meter">
      <div class="sl-bar"><i></i></div>
      <div class="sl-pct">Loading 0%</div>
    </div>
    <div class="sl-flash"></div>
  </div>

  <slot />

  <!-- Loading Controller -->
  <script is:inline>
  (function () {
    var root = document.documentElement, el = document.getElementById('site-loader');
    if (!el) { root.classList.remove('sl-lock'); return; }
    var bar = el.querySelector('.sl-bar i'), label = el.querySelector('.sl-pct');
    var start = Date.now(), done = false, seen = false, shown = 0;
    try { seen = sessionStorage.getItem('azmi_seen') === '1'; } catch (e) {}
    // Stays up until the page's content is really in, and never flashes by too fast.
    var MIN_MS = seen ? 900 : 2200;
    var MAX_MS = 15000; // safety cap on very slow connections

    function show(p) {
      shown = Math.max(shown, p); // never go backwards
      if (bar) bar.style.transform = 'scaleX(' + Math.max(0.04, shown) + ')';
      if (label) label.textContent = 'Loading ' + Math.round(shown * 100) + '%';
    }
    function finish() {
      if (done) return;
      done = true;
      show(1);
      setTimeout(function () {
        el.classList.add('sl-out');
        root.classList.remove('sl-lock');
        try { sessionStorage.setItem('azmi_seen', '1'); } catch (e) {}
        setTimeout(function () { el.remove(); }, 1600);
      }, Math.max(450, MIN_MS - (Date.now() - start)));
    }

    // Everything the visitor sees first: the hero filmstrip plus every gallery
    // card on the first screen (and a bit below), once the gallery has rendered.
    function firstScreenImages() {
      var limit = window.innerHeight * 1.6;
      var strip = [].slice.call(document.querySelectorAll('#filmstrip-marquee-inner img')).slice(0, 10);
      var cards = [].slice.call(document.querySelectorAll('#portfolio-gallery .gallery-item > a img')).filter(function (img) {
        var r = img.getBoundingClientRect();
        return r.top < limit;
      });
      if (!document.getElementById('portfolio-gallery')) {
        // Other pages (about, photo pages): wait for the images in view.
        return [].slice.call(document.querySelectorAll('main img')).filter(function (img) {
          return img.getBoundingClientRect().top < limit;
        }).slice(0, 6);
      }
      return strip.concat(cards.length ? cards : [].slice.call(document.querySelectorAll('#portfolio-gallery img')).slice(0, 8));
    }

    function track() {
      var imgs = firstScreenImages();
      var fontsReady = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
      var total = imgs.length + 1, loaded = 0;
      function one() { loaded++; show(0.15 + 0.85 * (loaded / total)); if (loaded >= total) finish(); }
      fontsReady.then(one, one);
      if (!imgs.length) return;
      imgs.forEach(function (img) {
        img.loading = 'eager';
        if (img.complete && img.naturalWidth) one();
        else { img.addEventListener('load', one, { once: true }); img.addEventListener('error', one, { once: true }); }
      });
    }

    // Wait for the gallery script to draw the cards before deciding what to wait for.
    show(0.06);
    var tries = 0;
    (function waitForGallery() {
      var g = document.getElementById('portfolio-gallery');
      var ready = !g || g.children.length > 0;
      if (ready || tries++ > 100) { show(0.15); track(); return; }
      setTimeout(waitForGallery, 50);
    })();
    setTimeout(finish, MAX_MS);
  })();
  </script>
</body>
</html>
