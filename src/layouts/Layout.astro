---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "〘卂乙爪丨〙ヅ - Photography & Digital Art Portfolio",
  description = "Explore the fine art photography and PicsArt digital artwork portfolio of Azizul Abedin Azmi. Professional portraiture, cultural street photojournalism, and creative digital edits.",
  image = "/dist/assets/Logo.png"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth dark">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>

  <!-- Loading screen fast-lock -->
  <script is:inline>
    document.documentElement.classList.add('sl-lock');
  </script>

  <style is:inline>
    #site-loader { display: none; }
    .sl-lock { overflow: hidden; }
    .sl-lock #site-loader {
      position: fixed; inset: 0; z-index: 9999; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 34px;
      min-height: 100dvh;
      background: radial-gradient(ellipse at 50% 42%, #1a170b 0%, #0b0b0b 58%, #060606 100%);
      color: #8f8f8f; font: 500 11px/1 "JetBrains Mono", ui-monospace, monospace;
    }
    #site-loader .sl-stage { position: relative; width: min(74vw, 420px); padding: 26px 30px; }
    #site-loader .sl-logo {
      display: block; width: 100%; height: auto; opacity: 0;
      animation: sl-focus 1.15s cubic-bezier(.2, .7, .2, 1) .1s forwards;
    }
    #site-loader .sl-shine {
      position: absolute; inset: 26px 30px; pointer-events: none;
      -webkit-mask: url(/dist/assets/loader-logo.webp) center / 100% 100% no-repeat;
              mask: url(/dist/assets/loader-logo.webp) center / 100% 100% no-repeat;
      background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,.95) 50%, transparent 65%) -150% 0 / 60% 100% no-repeat;
      animation: sl-shine 2.2s ease-in-out 1.1s infinite;
    }
    #site-loader .sl-corner { position: absolute; width: 22px; height: 22px; border: 2px solid #ffe800; opacity: 0; animation: sl-corner 1s cubic-bezier(.2, .7, .2, 1) forwards; }
    #site-loader .sl-tl { top: -10px; left: -10px; border-right: 0; border-bottom: 0; --x: -14px; --y: -14px; }
    #site-loader .sl-tr { top: -10px; right: -10px; border-left: 0; border-bottom: 0; --x: 14px; --y: -14px; }
    #site-loader .sl-bl { bottom: -10px; left: -10px; border-right: 0; border-top: 0; --x: -14px; --y: 14px; }
    #site-loader .sl-br { bottom: -10px; right: -10px; border-left: 0; border-top: 0; --x: 14px; --y: 14px; }
    #site-loader .sl-dot { position: absolute; top: 4px; right: 8px; width: 7px; height: 7px; border-radius: 50%; background: #ff3b30; opacity: 0; animation: sl-rec 1.2s steps(2, jump-none) 1s infinite; }
    #site-loader .sl-meter { display: flex; flex-direction: column; align-items: center; gap: 12px; opacity: 0; animation: sl-fade .6s ease .5s forwards; }
    #site-loader .sl-bar { width: 180px; height: 2px; background: rgba(255,255,255,.12); border-radius: 2px; overflow: hidden; }
    #site-loader .sl-bar i { display: block; height: 100%; background: #ffe800; transform: scaleX(.04); transform-origin: left; transition: transform .35s ease; }
    #site-loader .sl-pct { letter-spacing: .32em; text-transform: uppercase; }
    #site-loader .sl-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
    #site-loader.sl-out { animation: sl-out .7s ease .18s forwards; pointer-events: none; }
    #site-loader.sl-out .sl-flash { animation: sl-flash .38s ease-out forwards; }
    @keyframes sl-focus { 0% { opacity: 0; filter: blur(14px); transform: scale(1.08); } 60% { opacity: 1; } 100% { opacity: 1; filter: blur(0); transform: scale(1); } }
    @keyframes sl-shine { 0% { background-position: -150% 0; } 60%, 100% { background-position: 250% 0; } }
    @keyframes sl-corner { from { opacity: 0; transform: translate(var(--x), var(--y)); } to { opacity: 1; transform: none; } }
    @keyframes sl-rec { 0% { opacity: 1; } 100% { opacity: .15; } }
    @keyframes sl-fade { to { opacity: 1; } }
    @keyframes sl-flash { 0% { opacity: 0; } 25% { opacity: .55; } 100% { opacity: 0; } }
    @keyframes sl-out { to { opacity: 0; transform: scale(1.03); visibility: hidden; } }
    @keyframes sl-fade-out { to { opacity: 0; visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) {
      #site-loader .sl-logo { animation: sl-fade .4s ease forwards; }
      #site-loader .sl-shine, #site-loader .sl-dot, #site-loader .sl-flash { display: none; }
      #site-loader .sl-corner { animation: sl-fade .4s ease forwards; transform: none; }
      #site-loader.sl-out { animation: sl-fade-out .4s ease forwards; }
    }
  </style>

  <!-- SEO Meta Tags -->
  <meta name="description" content={description} />
  <meta name="keywords" content="Azizul Abedin Azmi, photography, portfolio, photographer, PicsArt, digital art, photo manipulation, portrait photography, developer portfolio" />
  <meta name="author" content="Azizul Abedin Azmi" />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <meta name="theme-color" content="#0a0a0a" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://azmi.is-cool.dev/" />
  <meta property="og:image" content={image} />
  <meta property="og:site_name" content="Azizul Abedin Azmi Photography & Art" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <meta name="twitter:creator" content="@azmi" />

  <link rel="canonical" href="https://azmi.is-cool.dev/" />

  <!-- Favicons -->
  <link rel="icon" type="image/x-icon" href="/dist/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/dist/assets/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/dist/assets/apple-touch-icon.png" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;800&family=JetBrains+Mono:wght@400;500;600&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Signika:wght@400;700&family=Nothing+You+Could+Do&display=swap" rel="stylesheet" />

  <!-- Fancybox v5 -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.umd.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fancyapps/ui@5.0/dist/fancybox/fancybox.css" />
  <link rel="stylesheet" href="/dist/output.css" />

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-LYGXJF62M9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-LYGXJF62M9');
  </script>

  <!-- Theme initialization to prevent FOUC -->
  <script is:inline>
    (function () {
      const stored = localStorage.getItem('azmi_theme');
      if (stored === 'light') {
        document.documentElement.classList.remove('dark');
      } else if (stored === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>

<body class="bg-white dark:bg-[#0a0a0a] text-neutral-900 dark:text-neutral-100 min-h-[100dvh] transition-colors duration-300 font-sans selection:bg-neutral-800 selection:text-white dark:selection:bg-white dark:selection:text-black overflow-x-hidden flex flex-col justify-between">

  <!-- Camera Shutter Flash Overlay -->
  <div id="camera-flash" class="fixed inset-0 bg-white pointer-events-none z-[9998] opacity-0"></div>

  <!-- Loading Screen -->
  <div id="site-loader" role="status" aria-live="polite" aria-label="Loading portfolio">
    <div class="sl-stage">
      <span class="sl-corner sl-tl"></span><span class="sl-corner sl-tr"></span>
      <span class="sl-corner sl-bl"></span><span class="sl-corner sl-br"></span>
      <span class="sl-dot"></span>
      <img class="sl-logo" src="/dist/assets/loader-logo.webp" width="720" height="153" alt="〘卂乙爪丨〙ヅ" />
      <span class="sl-shine"></span>
    </div>
    <div class="sl-meter">
      <div class="sl-bar"><i></i></div>
      <div class="sl-pct">Loading 0%</div>
    </div>
    <div class="sl-flash"></div>
  </div>

  <slot />

  <!-- Loading Controller -->
  <script is:inline>
  (function () {
    var root = document.documentElement, el = document.getElementById('site-loader');
    if (!el) { root.classList.remove('sl-lock'); return; }
    var bar = el.querySelector('.sl-bar i'), label = el.querySelector('.sl-pct');
    var start = Date.now(), done = false, seen = false;
    try { seen = sessionStorage.getItem('azmi_seen') === '1'; } catch (e) {}
    var MIN_MS = seen ? 200 : 900;
    var MAX_MS = 6000;

    function show(p) {
      if (bar) bar.style.transform = 'scaleX(' + Math.max(0.04, p) + ')';
      if (label) label.textContent = 'Loading ' + Math.round(p * 100) + '%';
    }
    function finish() {
      if (done) return;
      done = true;
      show(1);
      setTimeout(function () {
        el.classList.add('sl-out');
        root.classList.remove('sl-lock');
        try { sessionStorage.setItem('azmi_seen', '1'); } catch (e) {}
        setTimeout(function () { el.remove(); }, 1000);
      }, Math.max(0, MIN_MS - (Date.now() - start)));
    }

    var imgs = [].slice.call(document.querySelectorAll('#portfolio-gallery img')).slice(0, 4)
      .concat([].slice.call(document.querySelectorAll('#filmstrip-marquee-inner img')).slice(0, 4));
    var total = imgs.length, loaded = 0;
    if (!total) window.addEventListener('load', finish);
    imgs.forEach(function (img) {
      img.loading = 'eager';
      function one() { loaded++; show(loaded / total); if (loaded >= total) finish(); }
      if (img.complete) one(); else { img.addEventListener('load', one, { once: true }); img.addEventListener('error', one, { once: true }); }
    });
    setTimeout(finish, MAX_MS);
  })();
  </script>
</body>
</html>
