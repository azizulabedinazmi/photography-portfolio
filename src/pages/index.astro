---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Gallery from '../components/Gallery.astro';
import ExifModal from '../components/ExifModal.astro';
import ZenMode from '../components/ZenMode.astro';
import Footer from '../components/Footer.astro';
import { items, slugs, categoryLabel, SITE, OWNER, OWNER_IMAGE, OWNER_PROFILES } from '../lib/photos';

// Only the owner's own picture (Avatar) is tied to the owner's name. Every photo and artwork has
// its own page (/photo/<slug>/) where it is indexed under its own title and subject instead.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE}/#person`,
    name: OWNER,
    alternateName: ['Azmi', '〘卂乙爪丨〙ヅ'],
    url: `${SITE}/`,
    image: OWNER_IMAGE,
    jobTitle: 'Photographer & Digital Artist',
    sameAs: OWNER_PROFILES
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: '〘卂乙爪丨〙ヅ',
    url: `${SITE}/`,
    author: { '@id': `${SITE}/#person` }
  }
];
---

<Layout title="〘卂乙爪丨〙ヅ - Azizul Abedin Azmi | Photography & Digital Art Portfolio" robots="noimageindex">
  
  <!-- Schema.org Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <Navbar />
  
  <main class="flex-1">
    <Hero />
    <Gallery />
    
    <!-- Editorial Quote Strip -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center border-t border-neutral-200 dark:border-neutral-800">
      <div class="max-w-3xl mx-auto">
        <svg class="w-10 h-10 mx-auto text-neutral-300 dark:text-neutral-700 mb-6" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/></svg>
        <blockquote class="text-xl sm:text-2xl font-serif italic text-neutral-800 dark:text-neutral-200 leading-relaxed mb-4">
          “What I love about photographs is that they capture a fleeting human moment that is gone forever — impossible to reproduce, yet etched in light eternally.”
        </blockquote>
        <div class="text-xs font-mono tracking-widest uppercase text-neutral-500">— Azizul Abedin Azmi</div>
      </div>
    </section>

    <!-- Index of every work: crawlable links to each photo's own page -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <details class="group rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/60 dark:bg-neutral-900/40">
        <summary class="cursor-pointer select-none list-none px-5 py-4 flex items-center justify-between text-xs font-mono uppercase tracking-widest text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition">
          <span>Index of all works ({items.length})</span>
          <span class="transition-transform group-open:rotate-45 text-base leading-none">+</span>
        </summary>
        <ul class="px-5 pb-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1.5 text-sm">
          {items.map((it: any, i: number) => (
            <li class="flex items-baseline gap-2 min-w-0">
              <span class="text-[10px] font-mono uppercase text-neutral-400 shrink-0 w-16">{categoryLabel(it.category)}</span>
              <a href={`/photo/${slugs[i]}/`} class="truncate text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white hover:underline underline-offset-4">{it.title}</a>
            </li>
          ))}
        </ul>
      </details>
    </section>
  </main>

  <!-- Modals & Drawers -->
  <ExifModal />
  <ZenMode />

  <Footer />

  <!-- Client-side Gallery Dataset and Logic -->
  <script src="/dist/gallery-data.js" is:inline></script>
  <script src="/dist/image-variants.js" is:inline></script>
  <script src="/dist/portfolio-smart.js" is:inline></script>
  
  <!-- Fancybox v5 Binding -->
  <script is:inline>
    if (window.Fancybox) {
      Fancybox.bind('[data-fancybox="gallery"]', {
        Thumbs: {
          autoStart: true,
        },
        Toolbar: {
          display: {
            left: ["infobar"],
            middle: ["zoomIn", "zoomOut", "toggle1to1", "rotateCCW", "rotateCW", "flipX", "flipY"],
            right: ["slideshow", "thumbs", "close"],
          },
        },
      });
      Fancybox.bind('[data-fancybox="filmstrip"]', {
        Thumbs: { autoStart: true }
      });
    }
  </script>

</Layout>
