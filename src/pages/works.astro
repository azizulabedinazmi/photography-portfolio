---
// Index of every work: one plain, crawlable list linking each /photo/<slug>/ page, grouped by category.
// Thumbnails carry "noimageindex" (like the homepage), so each image is indexed on its own page only.
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { items, slugs, SITE, framesOf, largestPath, srcsetOf, variantOf, categoryLabel } from '../lib/photos';

const ORDER = ['portraits', 'events', 'nature', 'art'];
const groups = new Map<string, { item: any; slug: string }[]>();
items.forEach((item, i) => {
  const key = item.category || 'other';
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push({ item, slug: slugs[i] });
});
const sections = [...groups.entries()].sort(
  ([a], [b]) => (ORDER.indexOf(a) + 1 || 99) - (ORDER.indexOf(b) + 1 || 99)
);
const plural = (c: string) =>
  ({ portraits: 'Portraits', events: 'Events', nature: 'Nature', art: 'Digital Art' } as Record<string, string>)[c] || categoryLabel(c);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All Works',
  url: `${SITE}/works/`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: items.length,
    itemListElement: items.map((it, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: it.title,
      url: `${SITE}/photo/${slugs[i]}/`
    }))
  }
};
---

<Layout
  title="All Works | Photography & Digital Art Index"
  description={`Index of all ${items.length} photographs and digital artworks in the portfolio: portraits, events, nature and digital art.`}
  robots="noimageindex"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline slot="head" />

  <Navbar />

  <main class="flex-1">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
      <a href="/" class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-widest text-neutral-500 hover:text-black dark:hover:text-white transition">← Back to gallery</a>
      <h1 class="mt-6 text-4xl sm:text-5xl font-serif font-bold tracking-tight text-neutral-950 dark:text-white">All <span class="italic font-normal">Works</span></h1>
      <p class="mt-3 text-base text-neutral-600 dark:text-neutral-300 font-light">{items.length} works across {sections.length} collections.</p>

      <nav class="mt-6 flex flex-wrap gap-2 text-xs font-mono" aria-label="Collections">
        {sections.map(([cat, list]) => (
          <a href={`#${cat}`} class="px-3 py-1.5 rounded-full bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-700 dark:text-neutral-300 hover:text-black dark:hover:text-white transition">
            {plural(cat)} · {list.length}
          </a>
        ))}
      </nav>

      {sections.map(([cat, list]) => (
        <section id={cat} class="mt-14 scroll-mt-28">
          <h2 class="text-2xl font-serif font-bold text-neutral-950 dark:text-white">{plural(cat)} <span class="text-sm font-mono font-normal text-neutral-500">({list.length})</span></h2>
          <ul class="mt-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4 sm:gap-6">
            {list.map(({ item, slug }) => {
              const frames = framesOf(item);
              const v = variantOf(frames[0]);
              return (
                <li>
                  <a href={`/photo/${slug}/`} class="group block">
                    <div class="aspect-square rounded-xl overflow-hidden bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800">
                      <img
                        src={largestPath(frames[0])}
                        srcset={srcsetOf(frames[0])}
                        sizes="(min-width: 1280px) 240px, (min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
                        alt={item.alt || item.title}
                        width={v?.w}
                        height={v?.h}
                        loading="lazy"
                        decoding="async"
                        class="w-full h-full object-cover transition duration-300 group-hover:scale-105"
                      />
                    </div>
                    <div class="mt-2 text-sm font-medium text-neutral-800 dark:text-neutral-200 group-hover:text-black dark:group-hover:text-white truncate">{item.title}</div>
                    <div class="text-[11px] font-mono uppercase tracking-widest text-neutral-500">
                      {categoryLabel(item.category)}{frames.length > 1 ? ` · ${frames.length} frames` : ''}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </section>
  </main>

  <Footer />
</Layout>
